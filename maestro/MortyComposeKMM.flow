# Shared by the Android and iOS apps: CI passes APP_ID with -e
appId: ${APP_ID}
---
- launchApp:
    clearState: true

# Characters and episodes come from the live Rick and Morty GraphQL API, so allow for a slow network
- extendedWaitUntil:
    visible: "Rick Sanchez"
    timeout: 30000
# The character images download after the text is up, and the screen can sit still in between,
# so waitForAnimationToEnd alone returns too early. Maestro has no sleep: wait for text that never
# appears (optional, so its timeout just continues) to give them time, then let the screen settle.
- extendedWaitUntil:
    visible: "maestro-image-delay-never-shown"
    timeout: 10000
    optional: true
- waitForAnimationToEnd:
    timeout: 15000
- takeScreenshot: MortyComposeKMM

- tapOn: "Episodes"
- extendedWaitUntil:
    visible: "Pilot"
    timeout: 30000
