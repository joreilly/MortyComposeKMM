# Shared by the Android and iOS apps: CI passes APP_ID with -e
appId: ${APP_ID}
---
- launchApp:
    clearState: true

# Characters and episodes come from the live Rick and Morty GraphQL API, so allow for a slow network
- extendedWaitUntil:
    visible: "Rick Sanchez"
    timeout: 30000
- takeScreenshot: MortyComposeKMM

- tapOn: "Episodes"
- extendedWaitUntil:
    visible: "Pilot"
    timeout: 30000
